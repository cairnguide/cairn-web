# Environment for the use case tests (npm run test:e2e).
# Points the real Worker at the local mock Auth0 and mock Cairn API in
# tests/e2e/mock-server.ts. Nothing here is a real credential: the session
# secret is 32 zero bytes, and the client secret is checked only by the mock.
ENVIRONMENT=test
CAIRN_API_ORIGIN=http://localhost:8799
CAIRN_API_TIMEOUT_MS=5000
AUTH0_ISSUER_BASE_URL=http://localhost:8799
AUTH0_CLIENT_ID=e2e-client
AUTH0_CLIENT_SECRET=e2e-not-a-secret
AUTH0_AUDIENCE=https://api.cairn.test
AUTH0_EMAIL_CONNECTION=email
AUTH0_EMAIL_MODE=passwordless
SESSION_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_MAX_AGE_SECONDS=3600
PRIVACY_POLICY_URL=http://localhost:8799/legal/privacy
TERMS_URL=http://localhost:8799/legal/terms
SUPPORT_URL=http://localhost:8799/support
SITE_URL=http://localhost:8799/site
