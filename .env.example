# cairn-web environment variables
# ------------------------------------------------------------------------------
# Copy this file to `.env` for local development (`cp .env.example .env`).
# Wrangler loads `.env` automatically for `wrangler dev`, and `.env.<name>` for
# `wrangler dev --env <name>`.
#
# Deployment pipelines provide the same variables per environment, for example
# `.env.production` and `.env.preview` generated from the pipeline's secret
# store, then pushed with `npm run env:push -- .env.production`.
# See README.md, "Environment variables" and "Deploying".
#
# Never commit a real `.env` file. .gitignore blocks every `.env*` except this one.
# `npm run check:env -- <file>` validates a file without printing any values.
# ------------------------------------------------------------------------------

# Which environment this is: development, test, preview, or production.
# Plain http URLs below are only accepted for localhost, in development or test.
ENVIRONMENT=development

# ---- Cairn API (cairnguide/cairn-core, api/) ---------------------------------
# Base URL of the Cairn API, without /v1 and without a trailing slash.
# The Worker forwards /api/v1/* to <CAIRN_API_ORIGIN>/v1/*.
CAIRN_API_ORIGIN=http://localhost:8000

# How long to wait for the API before giving up, in milliseconds.
CAIRN_API_TIMEOUT_MS=15000

# ---- Auth0 (see cairn-core auth0/README.md) -----------------------------------
# The Auth0 tenant (or custom domain) as a full URL, no trailing slash.
# Must be the same tenant as the API's CAIRN_AUTH0_DOMAIN.
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com

# The "Regular Web Application" created for cairn-web in Auth0.
AUTH0_CLIENT_ID=replace-with-client-id
# SECRET. Store in the pipeline's secret manager, never in a committed file.
AUTH0_CLIENT_SECRET=replace-with-client-secret

# The Cairn API identifier. Must equal the API's CAIRN_AUTH0_AUDIENCE.
AUTH0_AUDIENCE=https://api.cairn.example

# The Auth0 connection used for "Continue with email".
# Must equal the API's CAIRN_AUTH0_EMAIL_CONNECTION. The API's default is the
# passwordless `email` connection (magic link, spec decision D-10).
AUTH0_EMAIL_CONNECTION=email

# How email sign-up works, which changes the words on the email screen:
#   passwordless  Auth0 emails a sign-in link (default, matches the API).
#   password      Auth0 asks for a password (15 characters minimum, NIST SP 800-63B-4).
AUTH0_EMAIL_MODE=passwordless

# ---- Session ------------------------------------------------------------------
# SECRET. At least 32 random bytes, base64 encoded. Encrypts the session cookie.
# Generate one with: openssl rand -base64 32
# Rotating it signs everyone out.
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-32

# Longest a sign-in lasts before Cairn asks again, in seconds (default 8 hours).
SESSION_MAX_AGE_SECONDS=28800

# ---- Public links shown on every page ----------------------------------------
# These are public URLs, served to the browser from /config.json.
PRIVACY_POLICY_URL=https://cairnguide.app/privacy
TERMS_URL=https://cairnguide.app/terms
SUPPORT_URL=https://cairnguide.app/support
# The marketing site (cairnguide/cairn-site).
SITE_URL=https://cairnguide.app
