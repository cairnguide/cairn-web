{
  "name": "cairn-web",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn web front end: sign-up, setup, home, Settings, breaks, subscriptions, cases, the journey, and tasks. Served by Cloudflare Workers.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --mode development && wrangler dev",
    "dev:mock": "npm run build && node scripts/dev-mock.ts",
    "dev:client": "vite build --mode development --watch",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint --max-warnings=0 .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:env": "node scripts/check-env.ts",
    "check:headers": "node scripts/check-headers.ts",
    "env:push": "node scripts/push-env.ts",
    "api:types": "node scripts/api-types.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.1.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
